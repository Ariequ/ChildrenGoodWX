.onboarding-page {
  min-height: 100vh;
  background: var(--brand-bg, #F7F9FC);
  padding: 80rpx 48rpx;
  box-sizing: border-box;
}

.step-header {
  margin-bottom: 80rpx;
  position: relative;
}

.step-header .title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-primary, #1F2937);
}

.back-btn {
  position: absolute;
  right: 0;
  top: 0;
  font-size: 28rpx;
  color: var(--brand-blue, #4D96FF);
}

.options {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.option-card {
  background: #fff;
  border-radius: 48rpx;
  padding: 48rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.06);
  border-bottom: 8rpx solid #f3f4f6;
}

.option-label {
  font-size: 36rpx;
  color: var(--text-primary, #1F2937);
}
