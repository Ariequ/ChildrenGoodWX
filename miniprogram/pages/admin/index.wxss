.admin-page {
  min-height: 100vh;
  background: var(--brand-bg, #F7F9FC);
  /* 底部留白：固定按钮区(约 240rpx + 按钮高度) + tab-bar，避免内容被挡 */
  padding-bottom: 380rpx;
  box-sizing: border-box;
}

.brand-bar {
  background: #fff;
  padding: 24rpx 48rpx 0;
}

.brand-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}

.header {
  display: flex;
  align-items: center;
  padding: 24rpx 48rpx 32rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--brand-blue, #4D96FF);
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-icon-box.icon-purple {
  background: #8B5CF6;
}

.header-icon {
  font-size: 32rpx;
}

.header-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary, #1F2937);
}

.tabs {
  display: flex;
  padding: 24rpx 48rpx;
  gap: 24rpx;
}

.tab {
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  color: #6B7280;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.tab.active {
  background: var(--brand-blue, #4D96FF);
  color: #fff;
}

.content {
  padding: 32rpx 48rpx;
}

.section {
  background: #fff;
  border-radius: 48rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary, #1F2937);
}

.btn-add {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  background: var(--brand-blue, #4D96FF);
  color: #fff;
  border-radius: 24rpx;
  border: none;
  line-height: 1.4;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.list-item:last-child {
  border-bottom: none;
}

.item-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-title {
  font-size: 28rpx;
  color: var(--text-primary, #1F2937);
}

.item-meta {
  font-size: 24rpx;
  color: #9CA3AF;
}

.item-stars {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.star-icon {
  font-size: 28rpx;
  color: #FFDA3D;
}

.star-suffix {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-left: 4rpx;
}

.item-actions {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  font-size: 26rpx;
  color: var(--brand-blue, #4D96FF);
}

.action-btn.danger {
  color: var(--brand-red, #FF6B6B);
}

.empty {
  text-align: center;
  padding: 60rpx;
  color: #9CA3AF;
  font-size: 28rpx;
}

/* 底部按钮区：留出 tab-bar(120rpx) + 安全区 + 间距，避免被底部导航遮挡 */
.footer-actions {
  position: fixed;
  bottom: 240rpx;
  left: 48rpx;
  right: 48rpx;
  display: flex;
  gap: 24rpx;
}

.btn-secondary,
.btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}

.btn-secondary {
  flex: 1;
  padding: 28rpx;
  font-size: 28rpx;
  background: #fff;
  color: #6B7280;
  border-radius: 32rpx;
  border: 1rpx solid #E5E7EB;
}

.btn-danger {
  flex: 1;
  padding: 28rpx;
  font-size: 28rpx;
  background: var(--brand-red, #FF6B6B);
  color: #fff;
  border-radius: 32rpx;
  border: none;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
}

.modal {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #fff;
  border-radius: 48rpx;
  padding: 48rpx;
  z-index: 101;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.15);
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 32rpx;
  color: var(--text-primary, #1F2937);
}

.modal-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #F9FAFB;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.modal-input.small {
  width: 160rpx;
  height: 64rpx;
  margin-bottom: 0;
}

.modal-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-label {
  font-size: 28rpx;
  color: #6B7280;
  margin-right: 24rpx;
}

.color-list {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.color-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
}

.color-dot.active {
  border-color: #1F2937;
}

.modal-btns {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.btn-ghost {
  flex: 1;
  padding: 24rpx;
  font-size: 28rpx;
  background: #F3F4F6;
  color: #6B7280;
  border-radius: 32rpx;
  border: none;
}

.modal .btn-primary {
  flex: 1;
  padding: 24rpx;
  font-size: 28rpx;
  background: var(--brand-blue, #4D96FF);
  color: #fff;
  border-radius: 32rpx;
  border: none;
}
