.login-page {
  min-height: 100vh;
  background: var(--brand-bg, #F7F9FC);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
  box-sizing: border-box;
}

.logo-area {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-text {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-primary, #1F2937);
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #6B7280;
}

.form-area {
  width: 100%;
  max-width: 560rpx;
}

.input-code {
  width: 100%;
  height: 96rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.err-msg {
  display: block;
  color: var(--brand-red, #FF6B6B);
  font-size: 26rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--brand-blue, #4D96FF);
  color: #fff;
  font-size: 32rpx;
  border-radius: 32rpx;
  border: none;
  margin-bottom: 24rpx;
}

.btn-ghost {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #F3F4F6;
  color: #6B7280;
  font-size: 28rpx;
  border-radius: 32rpx;
  border: none;
}
