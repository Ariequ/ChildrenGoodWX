.rewards-page {
  min-height: 100vh;
  background: var(--brand-bg, #F7F9FC);
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 48rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-icon {
  font-size: 44rpx;
}

.header .logo {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary, #1F2937);
}

.score-badge {
  display: flex;
  align-items: center;
  flex-direction: row;
  gap: 12rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #FFF8E1;
  border: 2rpx solid #FFECB3;
}

.score-star {
  font-size: 36rpx;
  color: #FFDA3D;
  -webkit-text-stroke: 1rpx #F5C518;
  line-height: 1;
}

.score-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #263238;
  line-height: 1;
}

.header-subtitle {
  padding: 16rpx 48rpx 24rpx;
  background: #fff;
  font-size: 28rpx;
  color: #6B7280;
}

.content {
  padding: 32rpx 32rpx 48rpx;
}

/* 两列网格：用 flex + 50% 宽 + 内边距留缝，兼容各机型（避免 grid 在部分机型不生效） */
.reward-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -12rpx;
}

.reward-grid-item {
  width: 50%;
  padding: 12rpx;
  box-sizing: border-box;
}

.empty {
  text-align: center;
  padding: 80rpx;
  color: #9CA3AF;
  font-size: 28rpx;
}

.reward-logs {
  margin-top: 48rpx;
}

.reward-logs-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.reward-logs-icon {
  font-size: 36rpx;
}

.reward-logs-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary, #1F2937);
}

.reward-log-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.reward-log-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.reward-log-item:last-child {
  border-bottom: none;
}

.reward-log-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FFEDD5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.reward-log-avatar text {
  font-size: 32rpx;
  line-height: 72rpx;
}

.reward-log-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.reward-log-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary, #1F2937);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reward-log-date {
  font-size: 24rpx;
  color: #9CA3AF;
}

.reward-log-cost {
  font-size: 32rpx;
  font-weight: bold;
  color: #E57373;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 兑换确认弹窗 */
.confirm-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.confirm-modal {
  width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.confirm-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #FFF8E1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-bottom: 32rpx;
  line-height: 120rpx;
}

.confirm-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary, #1F2937);
  margin-bottom: 20rpx;
}

.confirm-desc {
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.confirm-btns {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
}

.confirm-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: bold;
  text-align: center;
}

.confirm-btn.cancel {
  background: #fff;
  color: var(--text-primary, #1F2937);
}

.confirm-btn.ok {
  background: var(--brand-blue, #4D96FF);
  color: #fff;
}

.confirm-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}
