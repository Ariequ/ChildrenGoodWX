<view class="habits-page">
  <view class="header">
    <view class="header-left">
      <icon type="success_no_circle" size="24" color="#4D96FF" />
      <text class="page-title">习惯</text>
    </view>
    <view class="score-badge">
      <text class="score-star">★</text>
      <text class="score-value">{{score}}</text>
    </view>
  </view>
  <view class="content">
    <view class="habit-grid" wx:if="{{habitRows.length}}">
      <view class="habit-row {{row.isBig ? 'big-row' : ''}}" wx:for="{{habitRows}}" wx:for-item="row" wx:key="rowIndex">
        <view class="habit-grid-item {{row.isBig ? 'big-item' : ''}}" wx:for="{{row.items}}" wx:for-item="h" wx:key="id">
          <habit-card wx:if="{{!h._empty}}" habit="{{h}}" bind:starChange="onStarChange" />
        </view>
      </view>
    </view>
    <view class="empty" wx:else>
      <view class="welcome-card">
        <text class="welcome-icon">🌱</text>
        <text class="welcome-title">萌芽好习惯</text>
        <text class="welcome-subtitle">AI智能总结，让好习惯养成更有趣</text>
        <view class="feature-list">
          <view class="feature-item">
            <text class="feature-icon">⭐</text>
            <text class="feature-text">星星打卡，激励孩子每日坚持</text>
          </view>
          <view class="feature-item">
            <text class="feature-icon">🎁</text>
            <text class="feature-text">积攒星星，兑换心仪奖励</text>
          </view>
          <view class="feature-item">
            <text class="feature-icon">🤖</text>
            <text class="feature-text">AI智能总结，记录成长点滴</text>
          </view>
        </view>
        <text class="welcome-tip">👇 点击下方「前往小程序」开始使用</text>
      </view>
    </view>
  </view>
</view>
