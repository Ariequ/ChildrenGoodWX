.habits-page {
  min-height: 100vh;
  background: var(--brand-bg, #F7F9FC);
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 48rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: var(--brand-blue, #4D96FF);
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-icon {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.logo {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary, #1F2937);
}

.score-badge {
  display: flex;
  align-items: center;
  flex-direction: row;
  gap: 12rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #FFF8E1;
  border: 2rpx solid #FFECB3;
}

.score-star {
  font-size: 36rpx;
  color: #FFDA3D;
  -webkit-text-stroke: 1rpx #F5C518;
  line-height: 1;
}

.score-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #263238;
  line-height: 1;
}

.content {
  padding: 32rpx 32rpx 48rpx;
}

/* 两列网格：按行成对，每行 flex 平分，左右严格等宽 */
.habit-grid {
  margin: 0 -14rpx;
}

.habit-row {
  display: flex;
  width: 100%;
  align-items: stretch;
}

.habit-grid-item {
  flex: 1;
  min-width: 0;
  padding: 14rpx;
  box-sizing: border-box;
  display: flex;
}

/* 让自定义组件占满格子宽高，同一行卡片等高 */
.habit-grid-item habit-card {
  display: block;
  width: 100%;
  height: 100%;
}

/* 3 星以上习惯独立一行 */
.big-row {
  display: block;
}

.big-item {
  flex: none;
  width: 100%;
}

.empty {
  text-align: center;
  padding: 80rpx;
  color: #9CA3AF;
  font-size: 28rpx;
}

.version {
  text-align: center;
  font-size: 24rpx;
  color: #9CA3AF;
  padding: 24rpx;
}
