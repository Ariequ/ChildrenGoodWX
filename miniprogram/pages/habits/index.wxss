.habits-page {
  min-height: 100vh;
  background: var(--brand-bg, #F7F9FC);
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 48rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-icon {
  font-size: 44rpx;
}

.logo {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary, #1F2937);
}

.score-badge {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--brand-yellow, #FFD93D);
  border: 6rpx solid #E5A00D;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.score-value {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.25);
}

.content {
  padding: 32rpx 32rpx 48rpx;
}

/* 两列网格：按行成对，每行 flex 平分，左右严格等宽 */
.habit-grid {
  margin: 0 -14rpx;
}

.habit-row {
  display: flex;
  width: 100%;
  align-items: stretch;
}

.habit-grid-item {
  flex: 1;
  min-width: 0;
  padding: 14rpx;
  box-sizing: border-box;
  display: flex;
}

/* 让自定义组件占满格子宽度 */
.habit-grid-item habit-card {
  display: block;
  width: 100%;
}

/* 3 星以上习惯独立一行 */
.big-row {
  display: block;
}

.big-item {
  flex: none;
  width: 100%;
}

.empty {
  text-align: center;
  padding: 80rpx;
  color: #9CA3AF;
  font-size: 28rpx;
}

.version {
  text-align: center;
  font-size: 24rpx;
  color: #9CA3AF;
  padding: 24rpx;
}
