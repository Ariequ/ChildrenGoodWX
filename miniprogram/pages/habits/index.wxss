.habits-page {
  min-height: 100vh;
  background: var(--brand-bg, #F7F9FC);
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

.brand-bar {
  background: #fff;
  padding: 24rpx 48rpx 0;
}

.brand-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 48rpx 32rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--brand-blue, #4D96FF);
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-icon {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary, #1F2937);
}

.score-badge {
  display: flex;
  align-items: center;
  flex-direction: row;
  gap: 12rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #FFF8E1;
  border: 2rpx solid #FFECB3;
}

.score-star {
  font-size: 36rpx;
  color: #FFDA3D;
  -webkit-text-stroke: 1rpx #F5C518;
  line-height: 1;
}

.score-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #263238;
  line-height: 1;
}

.content {
  padding: 32rpx 32rpx 48rpx;
}

/* 两列网格：按行成对，每行 flex 平分，左右严格等宽 */
.habit-grid {
  margin: 0 -14rpx;
}

.habit-row {
  display: flex;
  width: 100%;
  align-items: stretch;
}

.habit-grid-item {
  flex: 1;
  min-width: 0;
  padding: 14rpx;
  box-sizing: border-box;
  display: flex;
}

/* 让自定义组件占满格子宽高，同一行卡片等高 */
.habit-grid-item habit-card {
  display: block;
  width: 100%;
  height: 100%;
}

/* 3 星以上习惯独立一行 */
.big-row {
  display: block;
}

.big-item {
  flex: none;
  width: 100%;
}

.empty {
  text-align: center;
  padding: 40rpx;
}

.welcome-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.welcome-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}

.welcome-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #1F2937;
  display: block;
  margin-bottom: 16rpx;
}

.welcome-subtitle {
  font-size: 28rpx;
  color: #6B7280;
  display: block;
  margin-bottom: 48rpx;
}

.feature-list {
  text-align: left;
  margin-bottom: 48rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
}

.feature-icon {
  font-size: 40rpx;
}

.feature-text {
  font-size: 28rpx;
  color: #374151;
}

.welcome-tip {
  font-size: 28rpx;
  color: #4D96FF;
  font-weight: 500;
  display: block;
  padding-top: 32rpx;
  border-top: 2rpx solid #F3F4F6;
}

.version {
  text-align: center;
  font-size: 24rpx;
  color: #9CA3AF;
  padding: 24rpx;
}

/* 连续打卡成就庆祝弹窗 */
.achievement-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.achievement-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.achievement-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  width: 520rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
  animation: achievement-bounce 0.5s ease-out;
}

@keyframes achievement-bounce {
  0% { transform: scale(0.5); opacity: 0; }
  60% { transform: scale(1.05); }
  100% { transform: scale(1); opacity: 1; }
}

.achievement-emoji {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.achievement-congrats {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.achievement-desc {
  font-size: 28rpx;
  color: #6B7280;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.achievement-badge {
  display: inline-block;
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 165, 0, 0.4);
}
