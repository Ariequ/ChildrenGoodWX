.system-page {
  min-height: 100vh;
  background: var(--brand-bg, #F7F9FC);
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

.header {
  padding: 32rpx 48rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.logo {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary, #1F2937);
}

.section {
  background: #fff;
  border-radius: 48rpx;
  padding: 32rpx;
  margin: 32rpx 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary, #1F2937);
  display: block;
  margin-bottom: 24rpx;
}

.import-form {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.import-form .modal-input {
  margin-bottom: 0;
}

.import-form .btn-primary {
  margin-top: 8rpx;
}

.btn-add {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  background: var(--brand-blue, #4D96FF);
  color: #fff;
  border-radius: 24rpx;
  border: none;
  line-height: 1.4;
}

.invite-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.invite-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #F9FAFB;
  border-radius: 24rpx;
}

.invite-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.invite-code {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--brand-blue, #4D96FF);
}

.invite-name {
  font-size: 24rpx;
  color: #6B7280;
}

.invite-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.action-btn {
  font-size: 26rpx;
  color: var(--brand-blue, #4D96FF);
}

.action-btn.danger {
  color: var(--brand-red, #FF6B6B);
}

.empty {
  text-align: center;
  padding: 60rpx;
  color: #9CA3AF;
  font-size: 28rpx;
}

.debug-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 24rpx;
}

.debug-item {
  padding: 28rpx;
  font-size: 28rpx;
  background: #F9FAFB;
  border-radius: 24rpx;
  color: var(--text-primary, #1F2937);
}

.debug-item.danger {
  color: var(--brand-red, #FF6B6B);
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
}

.modal {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #fff;
  border-radius: 48rpx;
  padding: 48rpx;
  z-index: 101;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.15);
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 32rpx;
  color: var(--text-primary, #1F2937);
}

.modal-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #F9FAFB;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.modal-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-label {
  font-size: 28rpx;
  color: #6B7280;
  margin-right: 24rpx;
}

.new-code {
  padding: 24rpx;
  background: #F0F9FF;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.new-code-label {
  font-size: 26rpx;
  color: #6B7280;
}

.new-code-value {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--brand-blue, #4D96FF);
}

.modal-btns {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.btn-ghost {
  flex: 1;
  padding: 24rpx;
  font-size: 28rpx;
  background: #F3F4F6;
  color: #6B7280;
  border-radius: 32rpx;
  border: none;
}

.modal .btn-primary {
  flex: 1;
  padding: 24rpx;
  font-size: 28rpx;
  background: var(--brand-blue, #4D96FF);
  color: #fff;
  border-radius: 32rpx;
  border: none;
}

.version {
  text-align: center;
  font-size: 24rpx;
  color: #9CA3AF;
  padding: 24rpx;
}
