<view class="habit-card">
  <view class="icon-area" style="background-color: {{habit.color || '#4D96FF'}}">
    <text class="icon-text">{{iconDisplay}}</text>
    <view class="streak-badge" wx:if="{{habit.streak >= 3}}">
      <text class="streak-text">🔥{{habit.streak}}天</text>
    </view>
  </view>
  <text class="title">{{habit.title}}</text>
  <view class="star-rating">
    <image
      class="star {{animatingStar === idx ? 'star-pop' : ''}}"
      wx:for="{{[1,2,3,4,5]}}"
      wx:key="*this"
      wx:for-item="idx"
      wx:if="{{idx <= (habit.maxStars || 3)}}"
      data-star="{{idx}}"
      bindtap="onStarTap"
      src="{{starsToday >= idx ? '/images/icons/star-filled.svg' : '/images/icons/star-empty.svg'}}"
    />
  </view>
</view>
