/* 组件宿主元素样式，确保占满父容器宽高（同一行等高） */
:host {
  display: block;
  width: 100%;
  height: 100%;
  flex: 1;
  min-width: 0;
}

.habit-card {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 0;
  background: #fff;
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 8rpx 8rpx 24rpx rgba(0,0,0,0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
}

.icon-area {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12), inset 0 1rpx 0 rgba(255, 255, 255, 0.25);
}

.icon-img {
  width: 64rpx;
  height: 64rpx;
  filter: brightness(0) invert(1);
}

.icon-text {
  font-size: 52rpx;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
  line-height: 1;
}

.title {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
  color: var(--text-primary, #1F2937);
  margin-bottom: 24rpx;
  min-height: 84rpx;
  flex: 1;
  display: block;
}

.star-rating {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  background: rgb(248, 249, 252);
  border-radius: 999rpx;
  padding: 16rpx 32rpx;
  margin-top: auto;
}

@keyframes star-pop {
  0% { transform: scale(1); }
  50% { transform: scale(1.25); }
  100% { transform: scale(1); }
}

.star {
  width: 44rpx;
  height: 44rpx;
  transition: transform 0.15s ease-out;
}

.star:active {
  transform: scale(0.9);
}

.star-pop {
  animation: star-pop 0.35s ease-out;
}
