.date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 48rpx;
  background: #fff;
  border-radius: 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  margin-bottom: 32rpx;
}

.arrow {
  font-size: 40rpx;
  color: var(--brand-blue, #4D96FF);
  padding: 16rpx;
}

.date-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.date-cn {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary, #1F2937);
}

.weekday {
  font-size: 24rpx;
  color: #9CA3AF;
}
