.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 120rpx;
  padding: 12rpx 24rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  margin: 0 24rpx 16rpx;
  background: #fff;
  border-radius: 48rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 16rpx 24rpx;
  margin: 0 6rpx;
  border-radius: 32rpx;
  color: #9CA3AF;
  transition: all 0.2s;
}

.tab-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.tab-icon-native {
  color: #9CA3AF;
}

.tab-icon-img {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.6;
}

.tab-item.active {
  color: var(--brand-blue, #4D96FF);
  background: #F0F4F8;
}

.tab-item.active .tab-icon-native {
  color: var(--brand-blue, #4D96FF);
}

.tab-item.active .tab-icon-img {
  opacity: 1;
}

.tab-text {
  font-size: 22rpx;
}
