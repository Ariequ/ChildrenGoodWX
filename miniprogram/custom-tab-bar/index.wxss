.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 120rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #9CA3AF;
  transition: all 0.2s;
}

.tab-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.tab-icon-native {
  color: #9CA3AF;
}

.tab-icon-img {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.75;
}

.tab-item.active {
  color: var(--brand-blue, #4D96FF);
}

.tab-item.active .tab-icon-wrap {
  border-radius: 50%;
  background: rgba(77, 150, 255, 0.2);
}

.tab-item.active .tab-icon-native {
  color: var(--brand-blue, #4D96FF);
}

.tab-item.active .tab-icon-img {
  opacity: 1;
}

.tab-text {
  font-size: 22rpx;
}
